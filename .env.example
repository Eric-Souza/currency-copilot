# Which model answers: google (default) or groq. Both have free tiers.
AI_PROVIDER=google
# Optional: override the provider's default model (gemini-3.5-flash-lite, openai/gpt-oss-120b)
AI_MODEL=
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional: Neon Postgres, for saved chats (without it, chats live only in the tab).
# The pooled URL (-pooler host) for the app, the direct one for `npm run db:migrate`
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full
