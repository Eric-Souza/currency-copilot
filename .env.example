# Which model answers: google (default) or groq. Both have free tiers.
AI_PROVIDER=google
# Optional: override the provider's default model (gemini-3.6-flash, openai/gpt-oss-120b)
AI_MODEL=
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# Neon Postgres, for saved chats (not used yet)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
